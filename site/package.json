{
  "name": "edges-brain-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/ensure-keyword-font.mjs",
    "prebuild": "node scripts/ensure-keyword-font.mjs",
    "pretest": "node scripts/ensure-keyword-font.mjs",
    "dev": "node scripts/ensure-ai-news-data.mjs && astro dev",
    "build": "node scripts/ensure-ai-news-data.mjs && astro build && node scripts/verify-dist.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.11",
    "@astrojs/rss": "^4.0.14",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@napi-rs/canvas": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.16.0",
    "d3-cloud": "^2.0.0",
    "echarts": "^6.1.0",
    "gray-matter": "^4.0.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "linkedom": "^0.18.15"
  }
}
