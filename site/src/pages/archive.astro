---
import ListPage from '../components/ListPage.astro';
import { getPosts } from '../lib/entries';
import { siteUrl } from '../lib/paths';

const posts = await getPosts();
const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = post.data.date ? String(post.data.date.getUTCFullYear()) : '未标日期';
  const list = byYear.get(year) ?? [];
  list.push(post);
  byYear.set(year, list);
}
---

<ListPage
  title="Archive"
  description="Essay archive."
  empty="成稿还在写。"
  groups={[...byYear.entries()].map(([year, items]) => ({
    heading: year,
    items: items.map((post) => ({
      title: post.data.title,
      href: siteUrl(`/posts/${post.id}`),
      date: post.data.date,
    })),
  }))}
/>
