---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatISODate } from '../lib/select.mjs';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date?: Date;
  source?: string;
  wide?: boolean;
  kicker?: string;
  badge?: string;
  headings?: Heading[];
  rss?: { title: string; href: string };
  /** Chapter list uses h2. AI news also lists h3 so each ranking platform is its own entry. */
  tocDepth?: number;
}

const { title, description, date, source, wide = false, kicker = '', badge = '', headings = [], rss, tocDepth = 2 } = Astro.props;
const iso = date ? formatISODate(date) : '';
const sections: { slug: string; text: string; children: { slug: string; text: string }[] }[] = [];
for (const heading of headings) {
  if (!heading.slug || !heading.text) continue;
  if (heading.depth === 2) {
    sections.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 3 && tocDepth >= 3 && sections.length > 0) {
    sections[sections.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}
---

<BaseLayout title={title} description={description} wide={wide} withToc rss={rss}>
  <article class="post has-toc">
    <nav class="toc" aria-label="章节">
      <ol>
        {
          sections.map((item) => (
            <li>
              <a href={`#${item.slug}`}>{item.text}</a>
              {item.children.length > 0 ? (
                <ol>
                  {item.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              ) : null}
            </li>
          ))
        }
      </ol>
    </nav>
    <header class="post-head">
      {
        iso || kicker ? (
          <p class="post-kicker">
            {iso ? <time datetime={iso}>{iso}</time> : null}
            {kicker ? <span>{iso ? ` · ${kicker}` : kicker}</span> : null}
          </p>
        ) : null
      }
      {badge ? <h1>{title}<span class="tag">{badge}</span></h1> : <h1>{title}</h1>}
    </header>
    <div class="prose">
      <slot />
    </div>
    {source ? <p class="source"><a href={source}>Source</a></p> : null}
  </article>
</BaseLayout>

<script>
  import { currentSectionIndex } from '../lib/toc-spy.mjs';

  const nav = document.querySelector('nav.toc');
  if (nav && 'IntersectionObserver' in window) {
    const items = [];
    for (const link of nav.querySelectorAll('a[href^="#"]')) {
      const raw = link.getAttribute('href')?.slice(1) ?? '';
      let id = raw;
      try {
        id = decodeURIComponent(raw);
      } catch {
        id = raw;
      }
      const section = id ? document.getElementById(id) : null;
      if (section) items.push({ link, section });
    }

    if (items.length > 0) {
      let active = null;
      const mark = (link) => {
        if (active === link) return;
        if (active) {
          active.classList.remove('is-current');
          active.removeAttribute('aria-current');
        }
        active = link;
        if (!active) return;
        active.classList.add('is-current');
        active.setAttribute('aria-current', 'location');
      };
      const update = () => {
        const line = Math.min(160, window.innerHeight * 0.28);
        const index = currentSectionIndex(
          items.map((item) => item.section.getBoundingClientRect().top),
          line,
        );
        mark(index >= 0 ? items[index].link : null);
      };
      const observer = new IntersectionObserver(update, {
        rootMargin: '0px 0px -65% 0px',
        threshold: [0, 1],
      });
      for (const item of items) observer.observe(item.section);
      update();
    }
  }
</script>
