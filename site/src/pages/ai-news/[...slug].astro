---
import '../../styles/keyword-cloud-font.css';
import { render } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import AiNewsProse from '../../components/AiNewsProse.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import SubscribeCopy from '../../components/SubscribeCopy.astro';
import { getAiNews } from '../../lib/entries';
import { formatCoverage } from '../../lib/ai-news.mjs';
import { githubBlob, siteUrl } from '../../lib/paths';

export async function getStaticPaths() {
  const issues = await getAiNews();
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { Content, headings } = await render(issue);
const container = await AstroContainer.create();
const html = await container.renderToString(Content);
const windowLabel = formatCoverage(issue.data.coverageStart, issue.data.coverageEnd);
---

<ArticlePage
  title={issue.data.title}
  description={issue.data.description}
  date={issue.data.date}
  kicker={`覆盖 ${windowLabel}`}
  badge={issue.data.legacy ? '旧版' : ''}
  headings={headings}
  tocDepth={3}
  source={githubBlob(issue.data.sourcePath)}
  rss={{ title: 'AI 资讯', href: siteUrl('/ai-news/rss.xml') }}
>
  <SubscribeCopy slot="subscribe" helpHref={siteUrl('/ai-news/subscribe/')} />
  <AiNewsProse html={html} />
</ArticlePage>

<script>
  const board = document.querySelector('[data-model-board]');
  if (board) {
    const { mountModelBoards } = await import('../../lib/model-charts-client.mjs');
    mountModelBoards(document);
  }
</script>

<script>
  import { mountRoughOutlines } from '../../lib/rough-outline.mjs';

  mountRoughOutlines(document);
</script>

<script>
  import { mountEntryFlash } from '../../lib/entry-flash.mjs';

  mountEntryFlash(document);
</script>
