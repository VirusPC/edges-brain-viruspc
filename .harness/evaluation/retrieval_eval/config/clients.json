{
  "codex": {
    "command": "codex",
    "sandbox": "read-only",
    "timeout_seconds": 600,
    "reasoning_summary": "detailed",
    "reasoning_effort": "high",
    "show_raw_reasoning": true
  },
  "pi": {
    "kind": "pi",
    "command": "pi",
    "provider": "minimax-cn",
    "model": "MiniMax-M3",
    "thinking": "high",
    "timeout_seconds": 600,
    "env": {
      "MINIMAX_CN_API_KEY": "$MINIMAX_API_KEY",
      "PI_TELEMETRY": "0"
    }
  }
}
