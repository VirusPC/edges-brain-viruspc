---
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-ext-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-ext-600.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-ext-400-italic.css';
import '@fontsource/caveat/latin-500.css';
import '@fontsource/caveat/latin-ext-500.css';
import '../styles/global.css';
import { siteUrl } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  home?: boolean;
  withToc?: boolean;
  rss?: { title: string; href: string };
}

const {
  title,
  description = 'Essays, notes, and projects by peng cheng.',
  wide = false,
  home = false,
  withToc = false,
  rss,
} = Astro.props;
const fullTitle = title ? `${title} · peng cheng` : 'peng cheng';
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

interface NavLink {
  href: string;
  label: string;
  key?: string;
  external?: boolean;
}

const links: NavLink[] = [
  { href: siteUrl('/posts'), label: 'Posts', key: 'posts' },
  { href: siteUrl('/notes'), label: 'Notes', key: 'notes' },
  { href: siteUrl('/projects'), label: 'Projects', key: 'projects' },
  { href: 'https://edges.viruspc.tech/teaching/', label: 'Teaching', external: true },
  { href: siteUrl('/ai-news'), label: 'AI News', key: 'ai-news' },
  { href: siteUrl('/about'), label: 'About', key: 'about' },
];

function current(link: NavLink) {
  if (link.external) return false;
  const target = link.href.replace(/\/$/, '');
  if (link.key === 'posts' || link.key === 'notes' || link.key === 'projects' || link.key === 'ai-news') {
    return path === target || path.startsWith(`${target}/`);
  }
  return path === target;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      try {
        var storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', storedTheme);
        }
      } catch (error) {}
    </script>
    <style is:inline>
      html[data-theme="dark"] { background: #1c1b19; color-scheme: dark; }
      html[data-theme="light"] { background: #fffcf7; color-scheme: light; }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={siteUrl('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="peng cheng" href={siteUrl('/rss.xml')} />
    {rss ? <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} /> : null}
  </head>
  <body class:list={[wide && 'is-post', home && 'is-home', withToc && 'has-toc']}>
    <a class="skip" href="#content">Skip to content</a>
    <div class="frame">
      <header class="top">
        <a class="mark" href={siteUrl('/')}>peng cheng</a>
        <div class="top-tools">
        <nav class="nav" aria-label="Sections">
          {
            links.map((link) => (
              <a
                href={link.href}
                rel={link.external ? 'noopener' : undefined}
                aria-current={current(link) ? 'page' : undefined}
                class:list={{ 'is-current': current(link) }}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="切换为黑夜模式">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M18.9 5.1l-1.6 1.6M6.7 17.3l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16.5 3.5a8.2 8.2 0 1 0 4 12.2A7 7 0 0 1 16.5 3.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
        </button>
        </div>
      </header>
      <script>
        import { bindThemeToggle } from '../lib/theme.mjs';
        bindThemeToggle();
      </script>
      <main id="content">
        <slot />
      </main>
      <footer class="colophon">
        <span class="colophon-links">
          <a href={siteUrl('/rss.xml')}>RSS</a>
          <a href="https://github.com/VirusPC/edges-brain-viruspc" rel="me noopener">GitHub</a>
        </span>
        <span>peng cheng</span>
      </footer>
    </div>
  </body>
</html>
