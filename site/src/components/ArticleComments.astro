---
import { feedbackIssueUrl, giscusReady } from '../lib/reader-feedback.mjs';

const ready = giscusReady();
const issueHref = feedbackIssueUrl('');
---

<section class="reader-comments" data-reader-comments aria-label="评论">
  <h2>评论</h2>
  <p>留言使用 GitHub 账号，不需要在本站另注册。</p>
  {
    ready ? (
      <div data-giscus></div>
    ) : (
      <p>评论配置还不完整，所以这里不放评论框。</p>
    )
  }
  <p>
    <a data-feedback-link href={issueHref} target="_blank" rel="noopener noreferrer">
      {ready ? '评论框打不开时，在 GitHub 反馈这篇文章' : '在 GitHub 反馈这篇文章'}
    </a>
  </p>
</section>

<script>
  import { mountGiscus } from '../lib/giscus-client.mjs';

  const root = document.querySelector('[data-reader-comments]');
  if (root) mountGiscus(root);
</script>
