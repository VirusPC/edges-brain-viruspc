{
  "type": "object",
  "required": [
    "id",
    "name",
    "source",
    "publisher",
    "category",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["模型榜单", "GitHub Trending", "博客", "国内互联网"]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "released": {
      "type": [
        "string",
        "null"
      ]
    },
    "price": {
      "type": "object"
    },
    "speed": {
      "type": "object"
    },
    "intelligence": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
