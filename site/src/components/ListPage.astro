---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from './EntryList.astro';

interface Item {
  title: string;
  href?: string;
  date?: Date;
}

interface MonthGroup {
  label: string;
  items: Item[];
}

interface YearGroup {
  heading: string;
  months?: MonthGroup[];
  items?: Item[];
}

interface Props {
  title: string;
  description?: string;
  items?: Item[];
  groups?: YearGroup[];
  empty?: string;
  /** Projects page only. Notes and posts leave this off and stay expanded. */
  collapseGroups?: boolean;
}

const { title, description, items = [], groups = [], empty = '', collapseGroups = false } = Astro.props;

function articleCount(group: YearGroup) {
  if (group.months) return group.months.reduce((sum, month) => sum + month.items.length, 0);
  return group.items?.length ?? 0;
}
---

<BaseLayout title={title} description={description}>
  <h1>{title}</h1>
  {
    groups.length > 0 ? (
      groups.map((group) => {
        const body = group.months ? (
          group.months.map((month) => (
            <section class="list-month">
              <h3>{month.label}</h3>
              <EntryList items={month.items} />
            </section>
          ))
        ) : (
          <EntryList items={group.items ?? []} />
        );
        return (
          <section class="archive-year">
            {collapseGroups ? (
              <details class="project-fold">
                <summary>
                  <h2>{group.heading}</h2>
                  <span class="project-fold-count">{articleCount(group)}</span>
                </summary>
                {body}
              </details>
            ) : (
              <>
                <h2>{group.heading}</h2>
                {body}
              </>
            )}
          </section>
        );
      })
    ) : (
      <EntryList items={items} empty={empty} />
    )
  }
</BaseLayout>
