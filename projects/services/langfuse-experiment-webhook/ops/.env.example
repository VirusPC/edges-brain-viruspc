# 运维壳：托管这个进程时的变量名。只保留空值，不要写入真实密钥。
# systemd：复制到 unit 里的 EnvironmentFile（示例 /etc/langfuse-experiment-webhook.env）。
# 可选容器：在本目录复制为 .env。仓库根 .gitignore 会忽略 .env。
#
# HTTP、签名、调度在框架仓 packages/services/experiment-webhook。
# 迁移步骤见 README.md。找不到框架包时进程退出。

# 框架仓检出。二选一。给 systemd 用时再取消注释。
# 可选容器不要填主机路径：镜像把 EDGES_ROOT 设为 /opt/edges。
# EDGES_ROOT=/ABSOLUTE/PATH/edges-framework
# EXPERIMENT_WEBHOOK_HOME=/ABSOLUTE/PATH/edges-framework/packages/services/experiment-webhook

# 监听。未设置时薄封装默认 0.0.0.0:8787，与隧道 ingress 一致。
# 框架包自己的默认是 127.0.0.1:8791。
HOST=0.0.0.0
PORT=8787

# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# 签名默认开启。密钥为空时 POST 返回 401，不会当未签名请求收下。
# 只在本机调试时设 EXPERIMENT_WEBHOOK_SIGNATURE=off。公网不要关。
LANGFUSE_WEBHOOK_SECRET=
EXPERIMENT_WEBHOOK_SIGNATURE=on
# 签名时间戳允许的偏差（秒）。
LANGFUSE_WEBHOOK_TOLERANCE_SECONDS=300

# 配齐之后，框架包在 202 之后读取 Dataset，并写 experiment trace 和分数。
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 可选。不设报告目录时，写到 business/reports/（不入库）。
# EXPERIMENT_WEBHOOK_REPORTS_DIR=/var/lib/langfuse-experiment-webhook/reports
# 可选。不设则用框架包自带的 registry.json。
# EXPERIMENT_WEBHOOK_REGISTRY=
# EXPERIMENT_RUN_TIMEOUT_SECONDS=600

# 已退役，进程只记下变量名、不读值：
# DRY_RUN、EXPERIMENT_RUNNER_CMD、EXPERIMENT_RUNNER_URL、
# EXPERIMENT_RUNNER_TIMEOUT_SECONDS、WEBHOOK_MAX_WORKERS、LANGFUSE_API_TIMEOUT_SECONDS。
