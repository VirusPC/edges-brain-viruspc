      "const": "summary"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "path"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "const": "skills/managed/weekly-ai-blogs-digest/references/summarize/summarize.md"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
