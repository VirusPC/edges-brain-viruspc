{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules",
    "data",
    "chapters"
  ],
  "properties": {
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "cards"
              ],
              "properties": {
                "title": {
                  "enum": [
                    "国内模型厂",
                    "国外模型厂",
                    "国内非模型厂",
                    "国外非模型厂"
                  ]
                },
                "cards": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
