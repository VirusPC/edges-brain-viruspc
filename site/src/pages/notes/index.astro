---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteIndex from '../../components/NoteIndex.astro';
import { getNotes } from '../../lib/entries';

const notes = await getNotes();
---

<BaseLayout title="Notes" description="Dated notes." skin="notes">
  <h1>Notes</h1>
  <NoteIndex notes={notes} />
</BaseLayout>
