---
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/entries';
import { buildProjectBrowser } from '../../lib/project-view.mjs';
import { buildProjectCatalog, projectsRoot } from '../../lib/projects.mjs';

const docs = await getProjects();
const catalog = buildProjectCatalog(projectsRoot());
const titles = new Map(docs.map((doc) => [doc.id, {
  title: doc.data.title,
  description: doc.data.isHub ? doc.data.description ?? '' : '',
}]));
const model = buildProjectBrowser(catalog, titles, null);
---

<BaseLayout title={model.title} description="Project workspaces.">
  <ProjectBrowser model={model} />
</BaseLayout>
