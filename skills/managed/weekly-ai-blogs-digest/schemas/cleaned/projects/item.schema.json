{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "publisher",
    "category",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["模型榜单", "GitHub Trending", "博客", "国内互联网"]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "released": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "stars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
