---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes } from '../../lib/entries';
import { githubBlob } from '../../lib/paths';
import { formatISODate } from '../../lib/select.mjs';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const iso = formatISODate(note.data.date);
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <article>
    <p class="note-kicker"><time datetime={iso}>{iso}</time></p>
    <h1>{note.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="source"><a href={githubBlob(note.data.sourcePath)}>Source</a></p>
  </article>
</BaseLayout>
