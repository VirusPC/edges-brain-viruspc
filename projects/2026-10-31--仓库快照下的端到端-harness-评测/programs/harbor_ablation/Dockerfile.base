FROM public.ecr.aws/docker/library/node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
RUN apt-get update && apt-get install -y --no-install-recommends python3 bash curl ca-certificates git ripgrep && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.162.1 && codex --version
WORKDIR /workspace
