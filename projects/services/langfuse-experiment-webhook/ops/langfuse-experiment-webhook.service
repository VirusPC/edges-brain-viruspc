# 宿主入口是 Edges CLI，不再用 python -m langfuse_experiment_webhook。
# 日常保活不必用这份 system unit：
#   edges config init
#   edges evaluation server install
#   edges evaluation server start
# 若仍用这份 system unit：把 User= 设成拥有 ~/.config/edges/edges.env、
# 且 PATH 上有 edges 的账号。--dev 让本 unit 当前台监督者。
# 不要调用不带 --dev 的 start，那会再去拉起 user systemd。
# 没设 User= 时 %h 是 /root。

[Unit]
Description=Edges evaluation server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/edges/edges.env
ExecStart=/usr/bin/env edges evaluation server start --dev
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
