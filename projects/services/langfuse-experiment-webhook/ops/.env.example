# 运维壳：托管这个进程时的变量名。只保留空值，不要写入真实密钥。
# systemd：复制到 unit 里的 EnvironmentFile（示例 /etc/langfuse-experiment-webhook.env）。
# 可选容器：在本目录复制为 .env。仓库根 .gitignore 会忽略 .env。

# 监听。默认 0.0.0.0:8787。
HOST=0.0.0.0
PORT=8787

# 未设置、空、1 都是 dry-run。只有 0 / false / no / off 才会调用 runner。
DRY_RUN=1

# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# 可选。设置后校验请求头 x-langfuse-signature（t=<unix>,v1=<hex>）。
# 未设置则跳过校验。不要把 Langfuse UI 里只显示一次的 secret 写进 git。
LANGFUSE_WEBHOOK_SECRET=
# 签名时间戳允许的偏差（秒）。
LANGFUSE_WEBHOOK_TOLERANCE_SECONDS=300

# 三个都设置时，后台用 Public API 按数据集名称取元数据，并请求 dataset-items 读条数。
# 缺任何一个就跳过，不报错给 Langfuse。
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_API_TIMEOUT_SECONDS=20

# 仅 DRY_RUN=0 时使用。两个都设置会先跑命令，再 POST URL。
# 命令按 shlex 拆分，不用 shell。标准输入是本次 job 的 JSON。
EXPERIMENT_RUNNER_CMD=
# POST 同一份 job JSON。只接受 http:// 或 https://。
EXPERIMENT_RUNNER_URL=
EXPERIMENT_RUNNER_TIMEOUT_SECONDS=600

# 同时处理的后台 job 上限。
WEBHOOK_MAX_WORKERS=4
