{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "version",
    "data",
    "articles_coverage",
    "chapters"
  ],
  "properties": {
    "skill": {
      "const": "weekly-ai-blogs-digest"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "articles_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "selected"
      ],
      "properties": {
        "raw": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "raw",
              "card"
            ]
          },
          "text": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "cards"
              ],
              "properties": {
                "title": {
                  "enum": [
                    "国内模型厂",
                    "国外模型厂",
                    "国内非模型厂",
                    "国外非模型厂"
                  ]
                },
                "cards": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
