---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getNotes, getPosts, getProjects } from '../lib/entries';
import { siteUrl } from '../lib/paths';

const posts = (await getPosts()).slice(0, 5);
const notes = (await getNotes()).slice(0, 8);
const projects = (await getProjects()).slice(0, 12);
---

<BaseLayout home>
  <h1>成稿、笔记与项目</h1>
  <p class="dek">亲手写的成稿、按日期公开的笔记，以及项目工作区。</p>
  <div class="home-grid">
    <section class="recent-posts" aria-labelledby="recent-posts">
      <h2 id="recent-posts">Posts</h2>
      <EntryList
        items={posts.map((post) => ({
          title: post.data.title,
          href: siteUrl(`/posts/${post.id}`),
          date: post.data.date,
        }))}
        empty="成稿还在写。"
      />
      <a class="more" href={siteUrl('/posts')}>All posts</a>
    </section>
    <section class="home-notes recent-notes" aria-labelledby="recent-notes">
      <h2 id="recent-notes">Notes</h2>
      <EntryList
        items={notes.map((note) => ({
          title: note.data.title,
          href: siteUrl(`/notes/${note.id}`),
          date: note.data.date,
        }))}
      />
      <a class="more" href={siteUrl('/notes')}>All notes</a>
    </section>
    <section class="home-projects recent-projects" aria-labelledby="recent-projects">
      <h2 id="recent-projects">Projects</h2>
      <EntryList
        items={projects.map((project) => ({
          title: project.data.title,
          href: project.data.hasHub ? siteUrl(`/projects/${project.id}`) : undefined,
          date: project.data.date,
        }))}
      />
      <a class="more" href={siteUrl('/projects')}>All projects</a>
    </section>
  </div>
</BaseLayout>
