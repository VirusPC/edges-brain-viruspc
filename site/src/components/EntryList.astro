---
import { formatISODate } from '../lib/select.mjs';

interface Item {
  title: string;
  href?: string;
  date?: Date;
}

interface Props {
  items: Item[];
  empty?: string;
}

const { items, empty = '' } = Astro.props;
---

{
  items.length === 0 ? (
    empty ? <p class="empty">{empty}</p> : null
  ) : (
    <ol class="post-list">
      {items.map((item) => {
        const iso = item.date ? formatISODate(item.date) : '';
        return (
          <li>
            {iso ? <time datetime={iso}>{iso}</time> : <span class="undated" />}
            {item.href ? <a href={item.href}>{item.title}</a> : <span class="is-plain">{item.title}</span>}
          </li>
        );
      })}
    </ol>
  )
}
