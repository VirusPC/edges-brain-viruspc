{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "routine",
    "data",
    "articles_coverage",
    "window",
    "sources",
    "chapters"
  ],
  "properties": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "weekly-ai-blogs-digest"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit", "path"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "const": ".edges/routines/weekly-ai-blogs-digest/INDEX.md"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "articles_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "selected"],
      "properties": {
        "raw": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "since", "until"],
      "properties": {
        "issue": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "since": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "until": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "count", "publishers"],
              "properties": {
                "title": {"const": "模型榜单"},
                "count": {"type": ["integer", "null"], "minimum": 0},
                "publishers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "url", "count"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
                      "count": {"type": ["integer", "null"], "minimum": 0}
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "count", "publishers"],
              "properties": {
                "title": {"const": "GitHub Trending"},
                "count": {"type": "integer", "minimum": 0},
                "publishers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "url", "count"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
                      "count": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "count", "publishers"],
              "properties": {
                "title": {"const": "博客"},
                "count": {"type": "integer", "minimum": 0},
                "publishers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "url", "count"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
                      "count": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "count", "publishers"],
              "properties": {
                "title": {"const": "国内互联网"},
                "count": {"type": "integer", "minimum": 0},
                "publishers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "url", "count"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
                      "count": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "cards": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "boards": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "cards"],
              "properties": {
                "title": {
                  "enum": ["国内模型厂", "国外模型厂", "国内非模型厂", "国外非模型厂"]
                },
                "cards": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
