---
import '../styles/subscribe.css';
import { SUBSCRIBE_PROMPT } from '../lib/subscribe-copy.mjs';

interface Props {
  /** List and issue pages link to the guide. The guide page omits it. */
  helpHref?: string;
}

const { helpHref = '' } = Astro.props;
---

<div class="sub-row" data-subscribe-copy aria-live="polite">
  <button type="button" class="sub-copy">
    <span class="i-copy">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
    </span>
    <span class="i-check">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </span>
    <span class="i-alert">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
        <path d="M12 9v4"></path>
        <path d="M12 17h.01"></path>
      </svg>
    </span>
    <span class="sub-label">复制订阅提示词</span>
  </button>
  {helpHref ? <a class="sub-help" href={helpHref}>说明</a> : null}
  <div class="sub-fallback">
    <p class="sub-fallback-label">没能自动复制，请手动复制这段：</p>
    <p class="sub-fallback-text">{SUBSCRIBE_PROMPT}</p>
  </div>
</div>

<script>
  import { mountSubscribeCopy } from '../lib/subscribe-copy.mjs';

  mountSubscribeCopy(document);
</script>
