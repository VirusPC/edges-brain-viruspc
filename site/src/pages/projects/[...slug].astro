---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/entries';
import { githubBlob } from '../../lib/paths';
import { formatISODate } from '../../lib/select.mjs';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((project) => project.data.hasHub)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const iso = project.data.date ? formatISODate(project.data.date) : '';
---

<BaseLayout title={project.data.title} description={project.data.description} skin="notes">
  <article>
    {iso ? <p class="note-kicker"><time datetime={iso}>{iso}</time></p> : null}
    <h1>{project.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="source"><a href={githubBlob(project.data.sourcePath)}>Source</a></p>
  </article>
</BaseLayout>
